DATABASE_URL=postgresql+asyncpg://postgres:your-password-here@localhost:5432/aniidco_portal
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-to-a-random-secret-in-production
ED25519_PRIVATE_KEY_HEX=generate-a-random-64-char-hex-string-with-python-secrets-token-hex-32

# Must match every LPU site's LPU_backend/.env SYNC_API_KEY exactly
SYNC_API_KEY=change-this-lpu-sync-key-in-production
# Public half of the LPU fleet's LPU_ED25519_PRIVATE_KEY_HEX (LPU_backend/.env) -- never the private half
LPU_ED25519_PUBLIC_KEY_HEX=

# Official Meta WhatsApp Cloud API (free tier) -- from Meta for
# Developers > your app > WhatsApp > API Setup. Leave unset to keep
# WhatsApp delivery disabled entirely.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Developer stage: if the WhatsApp OTP can't be delivered (token expired --
# the Meta developer token resets daily -- or not configured), the OTP falls
# back to 123456 so you can still log in. Set to false in production.
OTP_DEV_FALLBACK=true
WHATSAPP_OTP_TEMPLATE_NAME=auth_otp_code
