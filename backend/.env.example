DATABASE_URL=postgresql+asyncpg://postgres:your-password-here@localhost:5432/aniidco_portal
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-to-a-random-secret-in-production
ED25519_PRIVATE_KEY_HEX=generate-a-random-64-char-hex-string-with-python-secrets-token-hex-32

# Must match every LPU site's LPU_backend/.env SYNC_API_KEY exactly
SYNC_API_KEY=change-this-lpu-sync-key-in-production
# Public half of the LPU fleet's LPU_ED25519_PRIVATE_KEY_HEX (LPU_backend/.env) -- never the private half
LPU_ED25519_PUBLIC_KEY_HEX=
